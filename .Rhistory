df |>
unnest_tokens(ngram, {{ text_column }}, token = "ngrams", n = 6) |>
filter(!is.na(ngram))
}
grams_original <- make_6grams(review_texts, text_original)
grams_stem     <- make_6grams(review_texts, text_stem)
grams_lemma    <- make_6grams(review_texts, text_lemma)
grams_nostop   <- make_6grams(review_texts_nostop, text_lemma_nostop)
# Summary: how many 6-grams, and how many are repeated in 2 or more reviews?
summarise_grams <- function(grams, label) {
per_gram <- grams |>
group_by(ngram) |>
summarise(n_reviews = n_distinct(review_id), .groups = "drop")
tibble(version = label,
total_6grams = nrow(grams),
different_6grams = nrow(per_gram),
found_in_2_or_more_reviews = sum(per_gram$n_reviews >= 2),
most_reviews = max(per_gram$n_reviews))
}
gram_summary <- bind_rows(
summarise_grams(grams_original, "Original words"),
summarise_grams(grams_stem,     "Stemmed words"),
summarise_grams(grams_lemma,    "Lemmatized words"),
summarise_grams(grams_nostop,   "Lemmatized, stop words removed")
) |>
mutate(pct_repeated = round(found_in_2_or_more_reviews / different_6grams * 100, 2))
gram_summary
# Frequency of every lemmatized 6-gram: in how many different reviews does it appear?
gram_freq <- grams_lemma |>
distinct(review_id, ngram, rating_overall) |>      # count a 6-gram once per review
group_by(ngram) |>
summarise(n_reviews = n(), avg_rating = round(mean(rating_overall), 2), .groups = "drop") |>
arrange(desc(n_reviews), avg_rating)
# Label each repeated 6-gram by the mood of the reviews that contain it
repeated_grams <- gram_freq |>
filter(n_reviews >= 2) |>
mutate(mood = case_when(avg_rating >= 3.5 ~ "Happy guests (avg rating 3.5+)",
avg_rating <= 2.5 ~ "Unhappy guests (avg rating 2.5 or less)",
TRUE              ~ "Mixed"))
cat("6-grams found in 2 or more reviews:", nrow(repeated_grams), "\n\n")
# ALL repeated 6-grams
print(repeated_grams, n = Inf)
gram_freq |>
count(n_reviews, name = "different_6grams") |>
ggplot(aes(x = factor(n_reviews), y = different_6grams)) +
geom_col(fill = "steelblue") +
geom_text(aes(label = comma(different_6grams)), vjust = -0.3) +
scale_y_log10(labels = comma, expand = expansion(mult = c(0, 0.15))) +
labs(title = "Almost every 6-gram appears in only one review",
subtitle = "Number of different 6-grams, by the number of reviews they appear in (log scale)",
x = "Number of reviews containing the 6-gram", y = "Number of different 6-grams (log scale)")
repeated_grams |>
slice_head(n = 20) |>
ggplot(aes(x = reorder(ngram, n_reviews), y = n_reviews, fill = mood)) +
geom_col() +
coord_flip() +
scale_fill_manual(values = c("Happy guests (avg rating 3.5+)" = "darkgreen",
"Unhappy guests (avg rating 2.5 or less)" = "firebrick",
"Mixed" = "grey60")) +
scale_y_continuous(breaks = 0:10) +
labs(title = "Top 20 repeated 6-grams in Ramada reviews (lemmatized)",
x = NULL, y = "Number of reviews containing the 6-gram", fill = NULL) +
theme(legend.position = "bottom")
# Label each repeated 6-gram by the mood of the reviews that contain it
