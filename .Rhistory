theme(legend.position = "bottom")
print(p)
}
# Chunk 56: wordclouds-ngrams
cloud_max   <- c(100, 80, 60, 50, 40, 30)
cloud_scale <- list(c(4, 0.7), c(3, 0.6), c(2.2, 0.5), c(1.6, 0.4), c(1.3, 0.4), c(1.1, 0.4))
for (k in 1:6) {
cd <- gram_tables[[k]] |>
filter(n_reviews >= 2) |>
add_mood() |>
arrange(desc(n_reviews), avg_rating) |>
slice_head(n = cloud_max[k]) |>
mutate(colour = case_when(str_detect(mood, "^Happy") ~ "darkgreen",
str_detect(mood, "^Unhappy") ~ "firebrick",
TRUE ~ "grey40"))
set.seed(123)
par(mar = c(0, 0, 2, 0))
wordcloud(words = cd$ngram, freq = cd$n_reviews, min.freq = 2, max.words = cloud_max[k],
scale = cloud_scale[[k]], rot.per = 0, random.order = FALSE,
ordered.colors = TRUE, colors = cd$colour)
title(paste0("Word cloud of repeated ", ngram_names[k],
" (green = happy guests, red = unhappy guests, grey = nutral)"), cex.main = 0.9)
}
# Chunk 57: lda-prepare
# Meaningful words only
content_words <- tokens_words |>
filter(!word %in% stop_words$word, !lemma %in% stop_words$word,
!word %in% custom_stop, !lemma %in% custom_stop, nchar(lemma) > 2)
# Keep words used in at least 5 reviews
common_terms <- content_words |>
distinct(review_id, lemma) |>
count(lemma) |>
filter(n >= 5) |>
pull(lemma)
# Document-term matrix: one row per review, one column per word
dtm <- content_words |>
filter(lemma %in% common_terms) |>
count(review_id, lemma) |>
cast_dtm(document = review_id, term = lemma, value = n)
cat("Reviews:", nrow(dtm), "| Words:", ncol(dtm), "\n")
# Chunk 58: lda-choose-k
perplexity_table <- map_dfr(2:6, function(k) {
m <- LDA(dtm, k = k, method = "Gibbs", control = list(seed = 123, burnin = 200, iter = 1000))
tibble(topics = k, perplexity = round(perplexity(m, dtm), 1))
})
perplexity_table
# Chunk 59: lda-fit
lda_model <- LDA(dtm, k = 4, method = "Gibbs", control = list(seed = 123, burnin = 200, iter = 1000))
# Top 10 words in each topic (beta = how strongly a word belongs to a topic)
topic_words <- tidy(lda_model, matrix = "beta") |>
group_by(topic) |>
slice_max(beta, n = 10, with_ties = FALSE) |>
ungroup()
topic_labels <- topic_words |>
group_by(topic) |>
summarise(label = paste0("Topic ", first(topic), ": ", paste(term[1:3], collapse = ", ")))
topic_words |>
group_by(topic) |>
summarise(top_words = paste(term, collapse = ", "))
# Chunk 60: lda-plot-words
topic_words |>
left_join(topic_labels, by = "topic") |>
ggplot(aes(x = reorder_within(term, beta, label), y = beta, fill = label)) +
geom_col(show.legend = FALSE) +
scale_x_reordered() +
coord_flip() +
facet_wrap(~ label, scales = "free_y") +
labs(title = "The four topics in Ramada reviews: top 10 words", x = NULL, y = "Word weight in the topic")
# Chunk 61: lda-topic-ratings
dominant_topic <- tidy(lda_model, matrix = "gamma") |>
mutate(review_id = as.numeric(document)) |>
group_by(review_id) |>
slice_max(gamma, n = 1, with_ties = FALSE) |>
ungroup() |>
left_join(ramada_reviews |> select(review_id, rating_overall), by = "review_id")
topic_summary <- dominant_topic |>
group_by(topic) |>
summarise(reviews = n(),
share_of_reviews_pct = round(n() / nrow(dominant_topic) * 100),
avg_rating = round(mean(rating_overall), 2),
pct_negative_reviews = round(mean(rating_overall <= 2) * 100)) |>
left_join(topic_labels, by = "topic")
topic_summary |> select(label, reviews, share_of_reviews_pct, avg_rating, pct_negative_reviews)
# Chunk 62: lda-plot-ratings
ggplot(topic_summary, aes(x = reorder(label, avg_rating), y = avg_rating, fill = avg_rating)) +
geom_col(show.legend = FALSE) +
geom_text(aes(label = paste0(avg_rating, " (", pct_negative_reviews, "% negative)")), hjust = -0.05, size = 3.5) +
coord_flip(ylim = c(0, 5.5)) +
scale_fill_gradient(low = "firebrick", high = "darkgreen") +
labs(title = "Average star rating of the reviews in each topic", x = NULL, y = "Average overall rating")
# Chunk 63: lda-phrases
topic_phrases <- map_dfr(1:4, function(t) {
terms   <- topic_words |> filter(topic == t) |> pull(term)
pattern <- paste0("\\b(", paste(terms, collapse = "|"), ")\\b")
map_dfr(2:6, function(k) {
gram_tables[[k]] |>
filter(n_reviews >= 2, str_detect(ngram, pattern)) |>
slice_head(n = 1) |>
mutate(n = k, topic = t)
})
}) |>
left_join(topic_labels, by = "topic")
topic_phrases |>
select(label, n, ngram) |>
pivot_wider(names_from = n, names_prefix = "n = ", values_from = ngram)
# Chunk 64: sentiment-setup
bing <- get_sentiments("bing")
positive_words <- bing$word[bing$sentiment == "positive"]
negative_words <- bing$word[bing$sentiment == "negative"]
negators <- c("not", "no", "never", "nothing", "without", "hardly", "cannot","wasn't", "isn't", "didn't", "don't", "doesn't", "couldn't", "wouldn't", "won't", "can't", "haven't", "hadn't", "hasn't", "weren't", "aren't")
# Score many n-grams at once (n = number of words in each n-gram)
score_ngrams <- function(ngrams, n, use_negation = TRUE) {
w <- str_split_fixed(ngrams, " ", n)
# a table with one column per word
s <- matrix(w %in% positive_words, ncol = n) -
# +1 for a positive word
matrix(w %in% negative_words, ncol = n)
# -1 for a negative word
if (use_negation && n > 1) {
after_negator <- cbind(FALSE, matrix(w[, 1:(n - 1)] %in% negators, ncol = n - 1))
s <- ifelse(after_negator, -s, s)
# flip if the previous word is a negator
}
rowSums(s)
}
# Readable text: lower case, letters and apostrophes only
clean_for_ngrams <- function(df) {
df |>
select(review_id, rating_overall, review_year, full_text) |>
mutate(clean = full_text |>
str_to_lower() |>
str_replace_all("[\u2018\u2019]", "'") |>      # curly quotes -> straight
str_replace_all("[^a-z' ]", " ") |>             # keep letters and apostrophes
str_squish())
}
ramada_clean <- clean_for_ngrams(ramada_reviews)
comp_clean   <- clean_for_ngrams(comp_reviews)
# Chunk 65: sentiment-loop
ramada_scored  <- list()   # all scored n-grams for Ramada (one table for each n)
review_scores  <- list()   # one row per review for Ramada and competitors
share_list     <- list()   # share of negative / neutral / positive n-grams
negation_share <- c()      # % of Ramada n-grams whose score changed because of negation
for (k in 1:6) {
# Ramada
rg <- ramada_clean |>
unnest_tokens(ngram, clean, token = "ngrams", n = k) |>
filter(!is.na(ngram))
rg$score <- score_ngrams(rg$ngram, k)
ramada_scored[[k]] <- rg
negation_share[k] <- mean(score_ngrams(rg$ngram, k, use_negation = FALSE) != rg$score) * 100
# Competitors (only the summaries are kept, to save memory)
cg <- comp_clean |>
unnest_tokens(ngram, clean, token = "ngrams", n = k) |>
filter(!is.na(ngram))
cg$score <- score_ngrams(cg$ngram, k)
summarise_reviews <- function(g, label) {
g |>
group_by(review_id, rating_overall, review_year) |>
summarise(avg_score = mean(score), pct_negative = mean(score < 0) * 100, .groups = "drop") |>
mutate(group = label, n = k)
}
review_scores[[k]] <- bind_rows(summarise_reviews(rg, "Ramada"),
summarise_reviews(cg, "Hamilton competitors"))
share_list[[k]] <- bind_rows(
tibble(n = k, group = "Ramada",               negative = mean(rg$score < 0) * 100,
neutral = mean(rg$score == 0) * 100, positive = mean(rg$score > 0) * 100),
tibble(n = k, group = "Hamilton competitors", negative = mean(cg$score < 0) * 100,
neutral = mean(cg$score == 0) * 100, positive = mean(cg$score > 0) * 100))
}
review_scores_all <- bind_rows(review_scores)
sentiment_share   <- bind_rows(share_list)
cat("Ramada n-grams scored for n = 1 to 6:", paste(comma(sapply(ramada_scored, nrow)), collapse = " | "), "\n")
# Chunk 66: sentiment-table
# One summary table for n = 1 to 6
sentiment_by_n <- review_scores_all |>
group_by(n) |>
summarise(
rho_with_stars       = cor(avg_score[group == "Ramada"], rating_overall[group == "Ramada"], method = "spearman"),
avg_score_ramada     = mean(avg_score[group == "Ramada"]),
avg_score_competitor = mean(avg_score[group == "Hamilton competitors"]),
p_value = wilcox.test(avg_score[group == "Ramada"], avg_score[group != "Ramada"], exact = FALSE)$p.value
) |>
left_join(sentiment_share |> filter(group == "Ramada") |> select(n, ramada_pct_negative = negative), by = "n") |>
left_join(sentiment_share |> filter(group != "Ramada") |> select(n, competitor_pct_negative = negative), by = "n") |>
mutate(ratio_negative = ramada_pct_negative / competitor_pct_negative,
pct_changed_by_negation = negation_share,
p_value = format.pval(p_value, digits = 2, eps = 2.2e-16)) |>
mutate(across(where(is.numeric), ~ round(.x, 2)))
sentiment_by_n |>
select(n, ramada_pct_negative, competitor_pct_negative, ratio_negative,
avg_score_ramada, avg_score_competitor, p_value, rho_with_stars, pct_changed_by_negation)
# Chunk 67: sentiment-share-plot
sentiment_share |>
ggplot(aes(x = n, y = negative, colour = group)) +
